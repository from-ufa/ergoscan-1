# Gateway / indexer
PORT=4400
# mainnet local node (production)
ERGO_NODE_URL=http://127.0.0.1:9053
NETWORK=mainnet
MOCK=0
# testnet example:
# ERGO_NODE_URL=http://127.0.0.1:9052
# NETWORK=testnet

# Web — prefer empty / same-origin behind HTTPS (Caddy → gateway).
# Do NOT hardcode a server IP (breaks after host migrate; mixed content on https://).
# NEXT_PUBLIC_GATEWAY_URL=
# NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_GATEWAY_PORT=4400

# Phase 2 indexer
# docker compose up -d postgres
DATABASE_URL=postgres://ergoscan:changeme@127.0.0.1:5432/ergoscan
INDEXER_ENABLED=0
BACKFILL_DEPTH=2000
POLL_MS=8000
