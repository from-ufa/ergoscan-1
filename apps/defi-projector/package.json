{
  "name": "@ergoscan/defi-projector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:t2t": "DEFI_T2T_ISOLATED=1 tsx src/t2t-index.ts",
    "start:ageusd": "tsx src/ageusd-index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@ergoscan/shared": "*",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
